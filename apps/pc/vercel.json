{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/stage-common.cjs",
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/consultation-messages",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/consultation-messages.js": {
      "maxDuration": 300
    },
    "api/consultation-summary.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
