{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/stage-common.cjs",
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/consultation-messages",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/consultation-messages.js": {
      "maxDuration": 300
    },
    "api/consultation-summary.js": {
      "maxDuration": 300
    }
  }
}
